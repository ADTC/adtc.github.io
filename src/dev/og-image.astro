---
import { Font } from "astro:assets";
import headshot from "../assets/headshot.jpg";
import data from "../data/resume.json";
import { site } from "../site";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Social preview image</title>
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
  </head>
  <body>
    <div class="card">
      <div class="card-ask">
        <p class="card-placeholder">Ask anything about my experience</p>
        <span class="card-send">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
          </svg>
        </span>
      </div>
      <div class="text">
        <h1 class="card-name">
          {data.name.split(" ").map((word) => <span>{word}</span>)}
        </h1>
        <p class="card-title">{site.jobTitle}</p>
        <ul class="card-facts">
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 1.75a4.5 4.5 0 0 0-4.5 4.5c0 3.25 4.5 8 4.5 8s4.5-4.75 4.5-8A4.5 4.5 0 0 0 8 1.75Z"></path>
              <circle cx="8" cy="6.25" r="1.5"></circle>
            </svg>
            {site.location}
          </li>
          <li class="card-url">{Astro.site?.host}</li>
        </ul>
      </div>
      <img class="card-photo" src={headshot.src} width={headshot.width} height={headshot.height} alt="" />
    </div>
  </body>
</html>

<style>
  .card {
    --ring: calc(0.6rem + 2px);

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr);
    align-items: center;
    gap: 2.25rem 4rem;
    width: 1200px;
    height: 630px;
    padding: 2.75rem 5.5rem 2.5rem;
    overflow: hidden;
    background: radial-gradient(60% 60% at 50% 0%, var(--accent-soft), transparent);
  }

  .card-ask {
    display: flex;
    grid-column: 1 / -1;
    justify-self: center;
    align-items: center;
    gap: 1rem;
    width: 48rem;
    padding: 0.75rem 0.75rem 0.75rem 2rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 20px 44px -24px oklch(20% 0.02 262 / 0.45);
  }

  .card-placeholder {
    color: var(--text-muted);
    font-size: 1.625rem;
    white-space: nowrap;
  }

  .card-send {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    opacity: 0.35;
  }

  .card-send svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .card-name {
    font-family: var(--font-serif);
    font-size: 6.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.92;
  }

  .card-name span {
    display: block;
  }

  .card-name span:first-child {
    color: var(--accent);
  }

  .card-title {
    margin-top: 1.6rem;
    color: var(--text-muted);
    font-size: 1.875rem;
    line-height: 1.3;
  }

  .card-facts {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.4rem;
    color: var(--text-muted);
    font-size: 1.375rem;
  }

  .card-facts li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .card-facts svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .card-url {
    padding: 0.35rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-weight: 500;
  }

  /* The ring spans from just above the "A" to just below the URL pill. */
  .card-photo {
    width: 24.125rem;
    height: 24.125rem;
    margin-top: 0.5rem;
    margin-right: var(--ring);
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 0.6rem var(--bg),
      0 0 0 var(--ring) var(--accent);
  }
</style>
