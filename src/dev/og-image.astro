---
import { Font } from "astro:assets";
import headshot from "../assets/headshot.jpg";
import data from "../data/resume.json";
import { site } from "../site";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Social preview image</title>
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
  </head>
  <body>
    <div class="card">
      <div class="text">
        <h1 class="card-name">
          {data.name.split(" ").map((word) => <span>{word}</span>)}
        </h1>
        <p class="card-title">{site.jobTitle}</p>
        <ul class="card-facts">
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 1.75a4.5 4.5 0 0 0-4.5 4.5c0 3.25 4.5 8 4.5 8s4.5-4.75 4.5-8A4.5 4.5 0 0 0 8 1.75Z"></path>
              <circle cx="8" cy="6.25" r="1.5"></circle>
            </svg>
            {site.location}
          </li>
          <li class="card-url">{Astro.site?.host}</li>
        </ul>
      </div>
      <img class="card-photo" src={headshot.src} width={headshot.width} height={headshot.height} alt="" />
    </div>
  </body>
</html>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4rem;
    width: 1200px;
    height: 630px;
    padding-inline: 5.5rem 5rem;
    overflow: hidden;
  }

  .card-name {
    font-family: var(--font-serif);
    font-size: 7rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.92;
  }

  .card-name span {
    display: block;
  }

  .card-name span:first-child {
    color: var(--accent);
  }

  .card-title {
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: 2.125rem;
    line-height: 1.3;
  }

  .card-facts {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 1.75rem;
    color: var(--text-muted);
    font-size: 1.5rem;
  }

  .card-facts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .card-facts svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .card-url {
    padding: 0.4rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-weight: 500;
  }

  .card-photo {
    width: 25rem;
    height: 25rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 0.6rem var(--bg),
      0 0 0 calc(0.6rem + 2px) var(--accent);
  }
</style>
